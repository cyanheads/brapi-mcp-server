# ── Transport ──────────────────────────────────────────────────────────
# MCP_TRANSPORT_TYPE=stdio          # stdio | http (default: stdio)
# MCP_HTTP_PORT=3010                # HTTP port (default: 3010)
# MCP_HTTP_HOST=127.0.0.1           # HTTP host (default: 127.0.0.1)
# MCP_HTTP_ENDPOINT_PATH=/mcp      # HTTP endpoint path (default: /mcp)
# MCP_PUBLIC_URL=                  # Public origin behind a TLS-terminating proxy (e.g. https://mcp.example.com)

# MCP_HTTP_MAX_BODY_BYTES=1048576    # Max inbound request body (default: 1 MiB). Raise for large genotype-call
                                    # payloads or bulk observation writes. Set to 0 to disable the cap.

# ── Auth ──────────────────────────────────────────────────────────────
# MCP_AUTH_MODE=none                # none | jwt | oauth (default: none)
# MCP_AUTH_SECRET_KEY=              # JWT secret (required for jwt mode)
# MCP_ALLOWED_ORIGINS=              # Comma-separated list (HTTP mode). Unset → loopback-only;
                                    # set to '*' to disable Origin validation (browser-facing deploys
                                    # behind a TLS proxy must list their public origin explicitly)

# ── Storage ───────────────────────────────────────────────────────────
# STORAGE_PROVIDER_TYPE=in-memory   # in-memory | filesystem | supabase | cloudflare-r2 | cloudflare-kv | cloudflare-d1

# ── Session ──────────────────────────────────────────────────────────
MCP_SESSION_MODE=stateful           # stateful | stateless | auto. `auto` is the framework default and resolves
                                    # to stateful for HTTP; this server pins `stateful` explicitly because
                                    # apply-mode observation writes ask for confirmation over a round trip that
                                    # 2025-era HTTP clients can only answer on a durable session, and because
                                    # per-session isolation keys off ctx.sessionId.
# MCP_HTTP_RESUMABILITY=false       # SSE replay on a dropped stateful stream. Default: true.
                                    # Kill switch only — no effect on stateless serving.
# MCP_HTTP_RESUMABILITY_MAX_EVENTS=512   # Retained per session, oldest evicted first
# MCP_HTTP_RESUMABILITY_TTL_MS=300000    # How long a retained event stays replayable
# BRAPI_SESSION_ISOLATION=true      # true (default) | false. Scope ServerRegistry connection state and the
                                    # CanvasBridge default canvas to ctx.sessionId when present (HTTP stateful/auto).
                                    # Concurrent HTTP callers under MCP_AUTH_MODE=none then operate in isolated
                                    # workspaces — registered aliases, exchanged tokens, and df_<uuid> namespaces
                                    # do not cross sessions. Set to false for the legacy multi-agent collaboration
                                    # model where every caller in the tenant shares one workspace. No effect on
                                    # stdio (no session) or HTTP stateless without exposeStatelessSessionId.
                                    # MCP protocol revision 2026-07-28 is session-less on every mode, so a client
                                    # negotiating it has no ctx.sessionId and falls back to the shared tenant
                                    # workspace regardless of this flag.

# ── Memory ───────────────────────────────────────────────────────────
# MCP_GC_PRESSURE_INTERVAL_MS=0     # Opt-in forced Bun.gc(true) interval, ms (Bun only). Drains old-gen backlog
                                    # under sustained HTTP load. Try 60000 if RSS grows. Default: 0.

# ── Logging ───────────────────────────────────────────────────────────
# MCP_LOG_LEVEL=info                # debug | info | notice | warning | error
# MCP_LOG_RATE_LIMIT_THRESHOLD=10   # Max emissions per level+message per window; 0 disables
# MCP_LOG_RATE_LIMIT_WINDOW_MS=60000

# ── Telemetry ─────────────────────────────────────────────────────────
# OTEL_ENABLED=false                          # Enable OpenTelemetry (default: false)
# OTEL_EXPORTER_OTLP_ENDPOINT=               # OTLP endpoint URL (e.g., http://localhost:4318)

# ── Server-specific ──────────────────────────────────────────────────
#
# Per-alias env vars — pattern: BRAPI_<ALIAS>_<FIELD>
#
# When the agent calls brapi_connect({ alias: 'bti-cassava' }) without
# baseUrl/auth, the server fills both from BRAPI_BTI_CASSAVA_* env vars.
# Falls back to the built-in registry, then BRAPI_DEFAULT_*, when the
# alias-specific var is unset. Explicit agent input wins over env, but env
# credentials are only sent to the base URL configured with them:
#   - An alias's credentials pair with its own BRAPI_<ALIAS>_BASE_URL, else its
#     enabled built-in URL. An agent baseUrl that differs is refused. Credentials
#     with neither (including a disabled built-in's leftovers) are never sent to
#     BRAPI_DEFAULT_BASE_URL — connect refuses until BRAPI_<ALIAS>_BASE_URL is set.
#   - BRAPI_DEFAULT_* credentials attach only to BRAPI_DEFAULT_BASE_URL, never to
#     another alias's own URL; give that alias its own credentials instead.
# Hyphens in alias names map to underscores in env (alias 'my-server' →
# BRAPI_MY_SERVER_*; built-in 'bti-cassava' → BRAPI_BTI_CASSAVA_*).
#
# Per alias you can set ONE credential family (mixing within an alias errors):
#   USERNAME + PASSWORD                  → mode 'sgn' (Breedbase /token exchange)
#   BEARER_TOKEN                         → mode 'bearer' (pre-obtained access token)
#   API_KEY [+ API_KEY_HEADER]           → mode 'api_key' (default header: Authorization)
#   OAUTH_CLIENT_ID + OAUTH_CLIENT_SECRET → mode 'oauth2' (client-credentials → /token exchange; optional OAUTH_TOKEN_URL override)
# No credential vars = no auth (public endpoints).
#
# BRAPI_<ALIAS>_DIALECT pins the dialect adapter for an alias when detection
# misfires: spec | brapi-test | breedbase | cassavabase | bms (auto or unset = detect).

# Default — `brapi_connect()` with no args connects here.
# BRAPI_DEFAULT_BASE_URL=https://test-server.brapi.org/brapi/v2
# One credential family for the default alias (attached only to BRAPI_DEFAULT_BASE_URL):
# BRAPI_DEFAULT_USERNAME=
# BRAPI_DEFAULT_PASSWORD=
# BRAPI_DEFAULT_BEARER_TOKEN=
# BRAPI_DEFAULT_API_KEY=
# BRAPI_DEFAULT_OAUTH_CLIENT_ID=
# BRAPI_DEFAULT_OAUTH_CLIENT_SECRET=
# BRAPI_DEFAULT_API_KEY_HEADER=Authorization   # also the fallback header for any api_key auth that names none

# Built-in aliases to remove (comma-separated, case-insensitive)
# BRAPI_BUILTIN_ALIASES_DISABLED=

# Built-in: Cassavabase (SGN) — `brapi_connect({ alias: 'bti-cassava' })`
# Base URL ships in the built-in registry; uncomment only to attach write creds.
# BRAPI_BTI_CASSAVA_USERNAME=
# BRAPI_BTI_CASSAVA_PASSWORD=

# Built-in: Sweetpotatobase (SGN) — `brapi_connect({ alias: 'bti-sweetpotato' })`
# BRAPI_BTI_SWEETPOTATO_USERNAME=
# BRAPI_BTI_SWEETPOTATO_PASSWORD=

# Triticeae Toolbox Wheat (SGN, login required) — `brapi_connect({ alias: 'wheat' })`
# Oat and barley follow the same shape at oat. / barley.triticeaetoolbox.org.
# BRAPI_WHEAT_BASE_URL=https://wheat.triticeaetoolbox.org/brapi/v2
# BRAPI_WHEAT_USERNAME=
# BRAPI_WHEAT_PASSWORD=

# Gigwa (no auth, genotyping-heavy) — `brapi_connect({ alias: 'gigwa' })`
# BRAPI_GIGWA_BASE_URL=https://gigwa.southgreen.fr/gigwa/rest/brapi/v2

# API-key auth example — `brapi_connect({ alias: 'prod' })`
# BRAPI_PROD_BASE_URL=https://my-brapi.example.com/brapi/v2
# BRAPI_PROD_API_KEY=
# BRAPI_PROD_API_KEY_HEADER=X-API-Key

# Pre-obtained bearer token example — `brapi_connect({ alias: 'cgiar' })`
# BRAPI_CGIAR_BASE_URL=https://api.cgiar.example.com/brapi/v2
# BRAPI_CGIAR_BEARER_TOKEN=

# Dataframe lifecycle
# BRAPI_DATASET_TTL_SECONDS=86400        # TTL for dataframe provenance metadata persisted alongside spilled rows

# Client behavior
# BRAPI_LOAD_LIMIT=1000                 # in-context row cap returned by find_* tools before spilling to a canvas dataframe
# BRAPI_PAGE_SIZE=1000                  # upstream pageSize used during canvas spillover walks (decoupled from BRAPI_LOAD_LIMIT); pairs with the 50-page ceiling for a 50,000-row dataframe cap
# BRAPI_MAX_CONCURRENT_REQUESTS=4       # parallel upstream fan-out cap
# BRAPI_RETRY_MAX_ATTEMPTS=3            # retries on 429/5xx
# BRAPI_RETRY_BASE_DELAY_MS=500         # exponential-backoff base
# BRAPI_REFERENCE_CACHE_TTL_SECONDS=3600   # TTL for cached capability profiles and reference data

# HTTP behavior
# BRAPI_REQUEST_TIMEOUT_MS=30000
# BRAPI_COMPANION_TIMEOUT_MS=8000        # timeout for non-critical enrichment calls (FK lookups, count probes); these skip retries
# BRAPI_SEARCH_POLL_TIMEOUT_MS=60000    # total budget for async /search polling
# BRAPI_SEARCH_POLL_INTERVAL_MS=1000    # interval between status checks
# BRAPI_ALLOW_PRIVATE_IPS=false         # dev-only — enables localhost / RFC 1918 targets

# Write surface
# BRAPI_ENABLE_WRITES=false              # opt-in — registers brapi_submit_observations when true

# Genotype-calls upstream pull limit (operator policy)
#
# Bounds total rows pulled from the upstream BrAPI server in a single
# brapi_find_genotype_calls or brapi_export_genotype_matrix invocation (a
# per-call maxCalls may lower it, never raise it), protecting upstream from unbounded
# sequential paginated GETs. Default 100,000 rows (≈10 pages at the standard
# pageSize=10,000); maximum 500,000 (≈50 pages, matching the per-query budget
# of other find_* tools). Tune down for cost-sensitive deployments; tune up
# only for upstreams you've confirmed can absorb the load.
#
# BRAPI_GENOTYPE_CALLS_MAX_PULL=100000
#
# Distinct-variant column ceiling per brapi_export_genotype_matrix matrix.
# Bounds the wide dataframe, the variantColumnLegend, and any VCF/PLINK text —
# all scale with column count, independent of the row (call) pull cap above. A
# schema-legal skew (one germplasm × many variants) can otherwise drive the
# column count to the full call budget and emit a multi-megabyte legend. A
# per-call maxColumns input may lower this ceiling, never raise it. Default
# 10,000 (legend ≈ 250 KB); maximum 500,000.
#
# BRAPI_GENOTYPE_MATRIX_MAX_COLUMNS=10000

# Dataframes (SQL/analytical workspace, backed by the framework's DataCanvas)
#
# DuckDB is mandatory and the only supported provider. `@duckdb/node-api`
# ships as a regular dependency; spilled find_* rows auto-register as
# dataframes named `df_<uuid>`. Not available on Cloudflare Workers.
#
# BRAPI_CANVAS_DROP_ENABLED=false        # opt-in for brapi_dataframe_drop (off by default; dataframes expire via TTL)
# BRAPI_CANVAS_MAX_ROWS=10000            # response cap on brapi_dataframe_query rows
# BRAPI_CANVAS_QUERY_TIMEOUT_MS=30000    # per-query wall-clock timeout

# Dataframe export (CSV/Parquet/JSON file output for human review)
#
# Setting BRAPI_EXPORT_DIR is the opt-in for `brapi_dataframe_export` —
# no separate enable flag. The path is the sandbox root; the framework
# rejects absolute paths and `..` traversal in the agent's filename input.
# Stdio-only: under MCP_TRANSPORT_TYPE=http the tool stays disabled
# regardless of this value (the returned path lives on the server, not
# the user). The entry point bridges this to CANVAS_EXPORT_PATH for the
# framework — operators only need to set the brapi-prefixed name.
#
# BRAPI_EXPORT_DIR=/tmp/brapi-mcp/exports
